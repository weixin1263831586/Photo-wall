{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Photo Wall desktop and mobile capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-fstat",
    "fs:scope-appcache",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPCACHE/*" }]
    },
    "log:default",
    "native-video:default"
  ]
}
