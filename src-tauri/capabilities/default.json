{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Photo Wall desktop and mobile capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-read-file",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPCACHE/*" }]
    },
    "log:default"
  ]
}
